<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/voice_controls" />

        <Button
            android:id="@+id/btn_dictionary"
            style="@style/Row"
            android:text="@string/dictionary" />

        <Button
            android:id="@+id/btn_numbers"
            style="@style/Row"
            android:text="@string/title_numbers" />

        <Button
            android:id="@+id/btn_system"
            style="@style/Row"
            android:text="@string/system_engine" />

        <Button
            android:id="@+id/btn_audio"
            style="@style/Row"
            android:text="@string/title_audio" />

        <Button
            android:id="@+id/btn_translation"
            style="@style/Row"
            android:text="@string/title_translation" />

        <Button
            android:id="@+id/btn_backup"
            style="@style/Row"
            android:text="@string/backup_button" />

        <Button
            android:id="@+id/btn_about"
            style="@style/Row"
            android:text="@string/about" />
    </LinearLayout>
</ScrollView>
