<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_numbers"
            style="@style/Row" />

        <TextView
            android:id="@+id/lbl_number_rate"
            style="@style/SliderLabel" />

        <br.com.geofilho.ttsg.PercentSeekBar
            android:id="@+id/seek_number_rate"
            style="@style/Slider" />

        <Button
            android:id="@+id/btn_punctuation"
            style="@style/Row" />

        <Button
            android:id="@+id/btn_emoji"
            style="@style/Row"
            android:text="@string/emoji_voice" />

        <Switch
            android:id="@+id/switch_gboard"
            style="@style/Row"
            android:text="@string/gboard_switch" />

        <EditText
            android:id="@+id/edit_test"
            style="@style/Row"
            android:hint="@string/hint_test_text"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:text="@string/numbers_test_text" />

        <Button
            android:id="@+id/btn_test"
            style="@style/Row"
            android:text="@string/listen" />
    </LinearLayout>
</ScrollView>
