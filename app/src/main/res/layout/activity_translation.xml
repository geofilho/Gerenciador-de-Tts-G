<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/switch_translate"
            style="@style/Row"
            android:text="@string/translate_switch" />

        <Switch
            android:id="@+id/switch_online"
            style="@style/Row"
            android:text="@string/translate_online_switch" />

        <Button
            android:id="@+id/btn_source"
            style="@style/Row" />

        <Button
            android:id="@+id/btn_target"
            style="@style/Row" />

        <TextView
            android:id="@+id/txt_system"
            style="@style/Row"
            android:accessibilityLiveRegion="polite"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_system_download"
            style="@style/Row"
            android:text="@string/system_download"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_device"
            style="@style/Row"
            android:accessibilityLiveRegion="polite"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_device_download"
            style="@style/Row"
            android:text="@string/device_download"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_email"
            style="@style/Row" />

        <TextView
            style="@style/Row"
            android:focusable="true"
            android:text="@string/translate_note" />

        <EditText
            android:id="@+id/edit_test"
            style="@style/Row"
            android:hint="@string/hint_test_text"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:text="@string/translate_test_text" />

        <Button
            android:id="@+id/btn_test"
            style="@style/Row"
            android:text="@string/translate_listen" />

        <Button
            android:id="@+id/btn_clear_saved"
            style="@style/Row" />

        <Button
            android:id="@+id/btn_help"
            style="@style/Row"
            android:text="@string/audio_help_button" />
    </LinearLayout>
</ScrollView>
