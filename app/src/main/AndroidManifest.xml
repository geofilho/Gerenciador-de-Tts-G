<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet e instalação de pacotes: usados só pela opção "Verificar atualização". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Necessário no Android 11+ para enxergar os motores de TTS instalados. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Atalhos ao manter o ícone pressionado: Dicionário, Saída de áudio e Tradução. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".DictionaryActivity"
            android:exported="false"
            android:label="@string/title_dictionary" />

        <activity
            android:name=".NumbersActivity"
            android:exported="false"
            android:label="@string/title_numbers" />

        <activity
            android:name=".AudioActivity"
            android:exported="false"
            android:taskAffinity=""
            android:label="@string/title_audio" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/title_diagnostics" />

        <activity
            android:name=".TranslationActivity"
            android:exported="false"
            android:taskAffinity=""
            android:label="@string/title_translation" />

        <activity
            android:name=".EmojiActivity"
            android:exported="false"
            android:label="@string/title_emoji" />

        <!-- Widget Dicionário: só o menu, por cima da tela inicial. -->
        <activity
            android:name=".DictionaryQuickActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/dictionary"
            android:taskAffinity=""
            android:theme="@style/TranslucentTheme" />

        <!-- Widgets da tela inicial: Dicionário, Saída de áudio e Tradução. -->
        <receiver
            android:name=".QuickWidget$Dictionary"
            android:exported="false"
            android:label="@string/widget_dictionary_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dictionary" />
        </receiver>
        <receiver
            android:name=".QuickWidget$Audio"
            android:exported="false"
            android:label="@string/widget_audio_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_audio" />
        </receiver>
        <receiver
            android:name=".QuickWidget$Translation"
            android:exported="false"
            android:label="@string/widget_translation_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_translation" />
        </receiver>

        <!-- Ações para atalhos (MacroDroid "Iniciar atalho" e lançadores). -->
        <activity
            android:name=".ShortcutPickerActivity"
            android:exported="true"
            android:label="@string/actions_label"
            android:theme="@style/TranslucentTheme">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Executa a ação do atalho sem mostrar tela (confere a senha interna do atalho). -->
        <activity
            android:name=".ActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Entradas com nome que explica a ação, para "Iniciar atividade de aplicativo" do MacroDroid
             (ele mostra o nome técnico da tela). Abrem a ação direto, sem mostrar tela. -->
        <activity-alias
            android:name=".Dicionario"
            android:exported="true"
            android:label="Dicionário"
            android:targetActivity=".ActionActivity" />
        <activity-alias
            android:name=".Ligar_traducao"
            android:exported="true"
            android:label="Ligar tradução"
            android:targetActivity=".ActionActivity" />
        <activity-alias
            android:name=".Desligar_traducao"
            android:exported="true"
            android:label="Desligar tradução"
            android:targetActivity=".ActionActivity" />
        <activity-alias
            android:name=".Ligar_saida_de_audio"
            android:exported="true"
            android:label="Ligar saída de áudio"
            android:targetActivity=".ActionActivity" />
        <activity-alias
            android:name=".Desligar_saida_de_audio"
            android:exported="true"
            android:label="Desligar saída de áudio"
            android:targetActivity=".ActionActivity" />
        <activity-alias
            android:name=".Alternar_traducao"
            android:exported="true"
            android:label="Alternar tradução"
            android:targetActivity=".ActionActivity" />
        <activity-alias
            android:name=".Alternar_saida_de_audio"
            android:exported="true"
            android:label="Alternar saída de áudio"
            android:targetActivity=".ActionActivity" />

        <!-- Configurações rápidas: Dicionário, Saída de áudio e Tradução (Android 7+). -->
        <service
            android:name=".QuickTile$Dictionary"
            android:exported="true"
            android:icon="@drawable/tile_dictionary"
            android:label="@string/shortcut_dictionary"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".QuickTile$Audio"
            android:exported="true"
            android:icon="@drawable/tile_audio"
            android:label="@string/shortcut_audio_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".QuickTile$Translation"
            android:exported="true"
            android:icon="@drawable/tile_translation"
            android:label="@string/shortcut_translation_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Responde à verificação de dados de voz que o sistema faz nos motores. -->
        <activity
            android:name=".CheckDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- O próprio app é um motor de TTS: aplica dicionário e emojis e repassa ao motor escolhido. -->
        <service
            android:name=".GTtsService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <!-- Entrega o APK baixado ao instalador do Android. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="br.com.geofilho.ttsg.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Lembrar o foco ao voltar (teste, só no Telegram). A pessoa ativa nas configurações de acessibilidade. -->
        <service
            android:name=".FocusMemoryService"
            android:exported="true"
            android:label="@string/focus_memory_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focus_memory" />
        </service>
    </application>
</manifest>
