<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet e instalação de pacotes: usados só pela opção "Verificar atualização". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Necessário no Android 11+ para enxergar os motores de TTS instalados. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DictionaryActivity"
            android:exported="false"
            android:label="@string/title_dictionary" />

        <activity
            android:name=".NumbersActivity"
            android:exported="false"
            android:label="@string/title_numbers" />

        <activity
            android:name=".EmojiActivity"
            android:exported="false"
            android:label="@string/title_emoji" />

        <!-- Responde à verificação de dados de voz que o sistema faz nos motores. -->
        <activity
            android:name=".CheckDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- O próprio app é um motor de TTS: aplica dicionário e emojis e repassa ao motor escolhido. -->
        <service
            android:name=".GTtsService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <!-- Entrega o APK baixado ao instalador do Android. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="br.com.geofilho.ttsg.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
